# MES Edge AI Worktime Analysis System
# Environment variable template
#
# Usage: copy this file to .env.local and fill in actual values
#   cp .env.example .env.local
#
# IMPORTANT: never commit .env.local to version control

# ─── Frontend (injected at Vite build time) ──────────────────────────

# Backend API address (dev: http://localhost:8000, prod: /api via nginx)
VITE_API_BASE=http://localhost:8000

# WebSocket real-time data URL
VITE_WS_URL=ws://localhost:8000/ws/realtime

# SSE event stream URL
VITE_SSE_URL=http://localhost:8000/sse/events

# ─── Docker Compose Ports ────────────────────────────────────────────

# API service port on host
API_PORT=8000

# Frontend HTTP port on host
FRONTEND_PORT=80

# InfluxDB admin UI port (dev only, leave empty in production to disable host exposure)
INFLUXDB_EXPOSE_PORT=8086

# ─── Redis ───────────────────────────────────────────────────────────

# Redis URL (internal Docker network, no host exposure)
# REDIS_URL=redis://redis:6379/0

# ─── InfluxDB ────────────────────────────────────────────────────────

# InfluxDB admin credentials (set during initial setup)
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=

# InfluxDB API token (create in InfluxDB UI after first login)
INFLUXDB_TOKEN=

# ─── Authentication ─────────────────────────────────────────────────

# JWT signing key (MUST change in production, use a strong random string >= 32 bytes)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ─── AI Service ──────────────────────────────────────────────────────

# DeepSeek API key (for AI chat proxy, server-side only)
DEEPSEEK_API_KEY=

# ─── Perception (Camera & Video Playback) ────────────────────────────

# Camera device index (0 = first camera)
CAMERA_ID=0

# Camera device path (for Docker device passthrough)
CAMERA_DEVICE=/dev/video0

# ─── Video Playback Mode ─────────────────────────────────────────────
# Set VIDEO_MODE=true and VIDEO_PATH to a video file to enable video playback
# This bypasses camera capture and processes the video file frame by frame

# Enable video playback mode (true/false)
VIDEO_MODE=false

# Video file path (must be inside data/videos/ directory for Docker volume mount)
# Example: /app/data/videos/assembly_line.mp4
VIDEO_PATH=

# Station ID for video playback (used in Redis Stream publishing)
STATION_ID=WS-01

# ─── Backend Runtime ────────────────────────────────────────────────

# SQLite database path (inside container)
# MES_DB_URL=sqlite:////app/data/mes.db

# MediaPipe GPU acceleration (1 = disabled, for server/Docker environments)
# Note: docker-compose.yml overrides this to 1 for container deployments
MEDIAPIPE_DISABLE_GPU=0

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Config file path (inside container)
CONFIG_PATH=./config.yaml

# ─── Deployment (GitHub Actions Secrets only) ────────────────────────
# Do NOT fill real values here; configure in GitHub repo Settings -> Secrets

# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=your-ssh-user
# DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
# FRONTEND_DEPLOY_PATH=/var/www/html/mes
# FRONTEND_URL=https://your-domain.com
