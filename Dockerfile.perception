# syntax = docker/dockerfile:1.12
# MES Perception Dockerfile — 多阶段构建
# MediaPipe video processing with camera support
#
# NOTE: Multi-stage build to minimize final image size.
#       Builder stage installs build deps; production stage copies only runtime.

# ========== 构建阶段 ==========
FROM python:3.12-slim AS builder

WORKDIR /build

# 系统依赖（编译用）
# 切换 Debian 镜像源（国内加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgomp1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# 复制并安装依赖
COPY mes-backend/requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com -r requirements.txt \
    opencv-python-headless \
    mediapipe==0.10.14

# ========== 生产阶段 ==========
FROM python:3.12-slim AS production

WORKDIR /app

# 最小系统依赖（仅运行时所需）
# 切换 Debian 镜像源（国内加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgomp1 \
    libgl1 \
    tini \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制已安装的 Python 包
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# 复制应用代码和配置（.dockerignore 负责排除不必要的文件）
COPY mes-backend/ /app/

# 健康检查
HEALTHCHECK --interval=15s --timeout=10s --start-period=15s --retries=3 \
    CMD sh -c "pgrep -f 'main.py' || exit 1"

EXPOSE 8000

ENTRYPOINT ["tini", "--"]
CMD ["python", "main.py", "--no-display", "--config", "/app/config.yaml"]
