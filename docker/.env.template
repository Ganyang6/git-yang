# MES Docker Compose Environment Variables Template
# ================================================
# Copy this file to .env.local in the project root and fill in actual values:
#   cp docker/.env.template .env.local
#
# Variables listed here are referenced in docker-compose.yml.
# Values below are defaults/placeholders -- override in .env.local.

# --- Ports ---
# API service port on host
API_PORT=8000

# Frontend HTTP port on host
FRONTEND_PORT=80

# InfluxDB admin UI port (bind to localhost only; leave empty to disable)
INFLUXDB_EXPOSE_PORT=8086

# --- InfluxDB ---
# Admin credentials (used only during first-time InfluxDB initialization)
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=mes-admin-2026

# InfluxDB API token (create in InfluxDB UI after first login)
INFLUXDB_TOKEN=

# --- Authentication ---
# JWT signing key -- MUST be a strong random string (>= 32 bytes).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- AI Service ---
# DeepSeek API key for AI analysis features (leave empty to disable)
DEEPSEEK_API_KEY=

# --- Perception (Camera) ---
# Camera device path for Docker device passthrough
CAMERA_DEVICE=/dev/video0

# Camera device index (0 = first camera)
CAMERA_ID=0
