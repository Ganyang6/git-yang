# syntax = docker/dockerfile:1.12
# MES API Dockerfile — 多阶段构建
# FastAPI main process - uvicorn HTTP server
#
# NOTE: This image is for the API server, NOT the perception process.
#       Use Dockerfile.perception for camera/MediaPipe workloads.

# ========== 构建阶段 ==========
FROM python:3.12-slim AS builder

WORKDIR /build

# 系统依赖（编译用，最终阶段不会保留）
# 切换 Debian 镜像源（国内加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 先复制 requirements，利用 Docker 层缓存加速
COPY mes-backend/requirements.txt ./

# 过滤掉测试依赖
RUN sed '/^pytest==/d;/^pytest$/d' requirements.txt > requirements.prod.txt \
    && rm requirements.txt

# 安装依赖（BuildKit cache mount 加速）
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com -r requirements.prod.txt

# ========== 生产阶段 ==========
FROM python:3.12-slim AS production

WORKDIR /app

# 最小化系统依赖（仅运行所需，不保留编译工具链）
# 切换 Debian 镜像源（国内加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgomp1 \
    tini \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 阶段复制已安装的 Python 包（不包含 pip 缓存）
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# 复制应用代码（排除 tests/ .venv 等非生产文件）
# .dockerignore 确保 tests/ 和 .venv 不会被复制进来
COPY mes-backend/ ./models/ ./scripts/ ./config*.yaml ./

# .dockerignore 已控制文件排除，无需 find 二次清理

# 创建模型和日志目录
RUN mkdir -p /app/models /app/logs

# N-P1-27: 非 root 用户运行
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# 健康检查：通过 HTTP /health 端点检测应用状态
# 直接使用 Python 标准库发送请求，无需额外依赖 curl/wget。
# interval=15s 确保快速发现异常，较短的 start-period 适合启动较快的 uvicorn。
HEALTHCHECK --interval=15s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=8); print('ok')"

EXPOSE 8000

# tini 作为 PID 1 初始化系统（正确处理信号转发）
ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
